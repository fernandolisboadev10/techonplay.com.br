---
import { socials } from '../data/socials';
const categories = [
  { label: 'Início', href: '/' },
  { label: 'Notícias', href: '/categoria/noticias/' },
  { label: 'Inteligência Artificial', href: '/categoria/inteligencia-artificial/' },
  { label: 'Jogos', href: '/categoria/jogos/' },
  { label: 'Tutoriais', href: '/categoria/tutoriais/' },
  { label: 'Dicas', href: '/categoria/dicas/' },
  { label: 'Curiosidades', href: '/categoria/curiosidades/' },
  { label: 'Reviews', href: '/categoria/reviews/' },
  { label: 'Apps', href: '/categoria/apps/' },
];

const quickLinks = [
  { label: 'Sobre Nós', href: '/sobre-nos' },
  { label: 'Contato', href: '/contate-nos' },
  { label: 'Anuncie', href: '/anuncie' },
];

---
<footer class="site-footer">
  <div class="container grid">
    <div class="about-col">
      <a href="/" class="brand" aria-label="TechOnPlay - Início">
        <img class="brand-logo" src="/images/logo.webp" alt="TechOnPlay" width="171" height="26" />
      </a>
      <p class="tagline">
        O TechOnPlay reúne guias, reviews e notícias sobre IA, jogos, tutoriais e curiosidades, sempre em linguagem simples, para você aproveitar melhor a tecnologia do dia a dia.
      </p>
      <ul class="socials" aria-label="Redes sociais">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer me" aria-label={s.label} title={s.label}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="col-title">Links rápidos</p>
      <ul>
        {quickLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="col-title">Categorias</p>
      <ul>
        {categories.map((c) => (
          <li><a href={c.href}>{c.label}</a></li>
        ))}
      </ul>
    </div>

  </div>

  <div class="bottom">
    <div class="container bottom-inner">
      <p>© {new Date().getFullYear()} TechOnPlay. Todos os direitos reservados.</p>
      <div class="legal-links">
        <a href="/politica-de-privacidade">Política de Privacidade</a>
        <a href="/termos-de-uso">Termos de Uso</a>
        <a href="/politica-de-cookies">Política de Cookies</a>
        <a href="#" data-open-cookie-settings>Configurações de cookies</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 40px;
    padding-block: 56px 40px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    margin: 0 0 16px;
  }

  .brand-logo {
    display: block;
    height: 26px;
    width: auto;
  }

  .tagline {
    color: var(--ink-soft);
    font-size: 0.9rem;
    max-width: 38ch;
    margin: 0 0 20px;
  }

  .col-title {
    position: relative;
    font-size: 0.95rem;
    color: var(--ink-strong);
    font-weight: 700;
    margin: 0 0 20px;
    padding-bottom: 12px;
  }

  .col-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 32px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
  }


  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  ul a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  ul a:hover {
    color: var(--teal);
  }

  ul.socials {
    flex-direction: row;
    gap: 10px;
  }

  ul.socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--ink-soft);
    color: var(--ink-soft);
    transition: color 0.15s, border-color 0.15s;
  }

  ul.socials a:hover {
    color: var(--teal);
    border-color: var(--teal);
  }

  .bottom {
    background: var(--ink-deep);
  }

  .bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 20px;
  }

  .bottom-inner p {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .legal-links {
    display: flex;
    gap: 24px;
  }

  .legal-links a {
    text-decoration: none;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .legal-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
