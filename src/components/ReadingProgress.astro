---
// Barra fina no topo que mostra quanto do artigo já foi lido.
---
<div class="reading-progress" id="reading-progress" role="progressbar" aria-label="Progresso de leitura" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
  <div class="reading-progress-fill"></div>
</div>

<script>
  // Reading progress via Motion scroll() (one passive, frame-synced observer instead of a hand-rolled
  // scroll listener). Motion is loaded only on article pages, and only when motion is allowed.
  const bar = document.getElementById('reading-progress');
  const fill = bar?.querySelector<HTMLElement>('.reading-progress-fill');
  // `.post` vira `display: contents` no mobile, então medimos o texto (.prose).
  const text = document.querySelector<HTMLElement>('.prose');
  // Começa a contar no topo do artigo (título e imagem), para a barra andar desde a primeira rolagem.
  const origin = document.querySelector<HTMLElement>('.post-shell') ?? text;

  if (bar && fill && text && origin && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    import('../scripts/motion-lib').then(({ scroll }) => {
      let last = -1;
      // Do começo do artigo até o fim do texto, não da página inteira.
      const range = () => {
        const top = origin.getBoundingClientRect().top + window.scrollY;
        const bottom = text.getBoundingClientRect().bottom + window.scrollY;
        return { top, total: bottom - top - window.innerHeight };
      };
      scroll((_progress: number) => {
        const { top, total } = range();
        const ratio = total > 0 ? (window.scrollY - top) / total : 1;
        const clamped = Math.min(1, Math.max(0, ratio));
        fill.style.transform = `scaleX(${clamped})`;
        bar.classList.toggle('is-visible', clamped > 0);
        const pct = Math.round(clamped * 100);
        if (pct !== last) {
          last = pct;
          bar.setAttribute('aria-valuenow', String(pct));
        }
      });
    });
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    contain: strict;
    z-index: 30;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .reading-progress.is-visible {
    opacity: 1;
  }

  .reading-progress-fill {
    height: 100%;
    /* Degradê da marca: verde-água, violeta e rosa. */
    background: linear-gradient(90deg, var(--teal), var(--violet), var(--rose));
    box-shadow: 0 0 8px color-mix(in srgb, var(--violet) 55%, transparent);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      transition: none;
    }
  }
</style>
