---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { categories as categoryList } from '../data/categories';
import { themes, themeHref, matchesTheme, MIN_THEME_POSTS } from '../data/themes.mjs';
import { isPublished } from '../utils/posts';

const posts = await getCollection('blog', isPublished);

const categories = [
  { label: 'IA', category: 'Inteligência Artificial' },
  { label: 'Jogos', category: 'Jogos' },
  { label: 'Tutoriais', category: 'Tutoriais' },
  { label: 'Dicas', category: 'Dicas' },
  { label: 'Curiosidades', category: 'Curiosidades' },
  { label: 'Reviews', category: 'Reviews' },
  { label: 'Sistemas', category: 'Sistemas' },
  { label: 'Apps', category: 'Apps' },
  { label: 'Tendências', category: 'Tendências' },
  { label: 'Educação', category: 'Educação' },
];

// Subcategorias (temas) que abrem ao passar o mouse sobre a categoria.
const subsOf = (cat?: { subthemes?: string[] }) =>
  (cat?.subthemes ?? [])
    .map((s) => themes.find((x) => x.slug === s))
    .filter((x) => x && posts.filter((p) => matchesTheme(x, p.id, p.data.tags ?? [])).length >= MIN_THEME_POSTS)
    .map((x) => ({ label: x.name, href: themeHref(x.slug) }));

const nav = [
  { label: 'Início', href: '/', subs: [] },
  ...categories.map((c) => {
    const cat = categoryList.find((x) => x.name === c.category);
    return { label: c.label, href: `/categoria/${cat?.slug}/`, subs: subsOf(cat) };
  }),
];

const currentHref = Astro.url.pathname + Astro.url.search;
---
<div class="scroll-sentinel" aria-hidden="true"></div>
<header class="site-header" id="site-header">
  <div class="container bar">
    <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
    <a href="/" class="brand" aria-label="TechOnPlay - Início">
      <Logo />
    </a>
    <nav class="nav">
      {nav.map((item) =>
        item.subs.length ? (
          <div class="dd">
            <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
            <div class="dd-menu">
              {item.subs.map((s) => <a href={s.href}>{s.label}</a>)}
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
        ),
      )}
    </nav>
    <div class="right-controls">
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Alternar tema escuro">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <line x1="12" y1="2" x2="12" y2="4" />
          <line x1="12" y1="20" x2="12" y2="22" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="2" y1="12" x2="4" y2="12" />
          <line x1="20" y1="12" x2="22" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
      </button>
      <div class="search-wrap">
        <form class="search-form" action="/blog" method="get" id="search-form">
          <input type="search" name="q" placeholder="Buscar artigos…" aria-label="Buscar artigos" />
        </form>
        <button type="button" class="search-toggle" id="search-toggle" aria-label="Abrir busca" aria-expanded="false">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav">
    {nav.map((item) =>
      item.subs.length ? (
        <div class:list={['m-group', { open: item.href === currentHref || item.subs.some((s) => s.href === currentHref) }]}>
          <button type="button" class="m-toggle" aria-expanded={item.href === currentHref || item.subs.some((s) => s.href === currentHref) ? 'true' : 'false'}>
            <span>{item.label}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </button>
          <div class="m-subs">
            <a href={item.href} class:list={['sub', 'all', { active: item.href === currentHref }]}>Ver tudo em {item.label}</a>
            {item.subs.map((s) => <a href={s.href} class="sub">{s.label}</a>)}
          </div>
        </div>
      ) : (
        <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
      ),
    )}
  </nav>
</header>
<div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>

<script>
  const searchToggle = document.getElementById('search-toggle');
  const searchWrap = document.querySelector('.search-wrap');
  const searchInput = document.querySelector<HTMLInputElement>('.search-form input');

  searchToggle?.addEventListener('click', () => {
    const open = searchWrap?.classList.toggle('open');
    searchToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) searchInput?.focus();
  });

  const themeToggle = document.getElementById('theme-toggle');

  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const currentIsDark =
      root.getAttribute('data-theme') === 'dark' ||
      (!root.hasAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
    const next = currentIsDark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  const backdrop = document.getElementById('nav-backdrop');

  const setMenu = (open: boolean) => {
    mobileNav?.classList.toggle('open', open);
    backdrop?.classList.toggle('open', open);
    menuToggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
  };

  menuToggle?.addEventListener('click', () => setMenu(!mobileNav?.classList.contains('open')));
  backdrop?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileNav?.classList.contains('open')) {
      setMenu(false);
      menuToggle?.focus();
    }
  });

  // The header gets its scrolled look from an IntersectionObserver, not a scroll listener.
  const sentinel = document.querySelector('.scroll-sentinel');
  const header = document.getElementById('site-header');
  if (sentinel && header && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }

  mobileNav?.querySelectorAll('.m-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.m-group');
      const open = group?.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 10;
    transition: border-color var(--dur-slow) ease, box-shadow var(--dur-slow) ease, background var(--dur-slow) ease;
  }

  /* One pixel at the top of the page: when it leaves the viewport the header turns "scrolled". */
  .scroll-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    box-shadow: var(--shadow-sm);
  }

  /* Height stays fixed (no layout shift); the logo scales instead. */
  .brand-logo {
    transform-origin: left center;
    transition: transform var(--dur-slow) var(--ease-standard);
  }

  .site-header.is-scrolled .brand-logo {
    transform: scale(0.92);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 64px;
    padding-block: 0;
    max-width: var(--container);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .brand-logo {
    display: block;
    height: 30px;
    width: auto;
    max-width: none;
  }

  .nav {
    display: flex;
    align-items: stretch;
    align-self: stretch;
    gap: 0;
    flex: 1;
    justify-content: center;
  }

  .nav a {
    position: relative;
    display: flex;
    align-items: center;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink);
    padding: 0 10px;
    white-space: nowrap;
    transition: color var(--dur-fast) ease;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 12px;
    height: 2px;
    background: var(--rose);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-normal) var(--ease-standard);
  }

  .nav a:hover,
  .nav a:focus-visible,
  .nav a.active {
    color: var(--ink-strong);
  }

  .nav a.active::after,
  .nav a:hover::after,
  .nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .dd {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .dd-menu {
    display: flex;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-normal) ease, transform var(--dur-normal) var(--ease-standard), visibility 0s linear var(--dur-normal);
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, -4px);
    min-width: 240px;
    padding: 6px;
    flex-direction: column;
    gap: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    z-index: 20;
  }

  .dd:hover .dd-menu,
  .dd:focus-within .dd-menu {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }

  .nav .dd-menu a {
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .nav .dd-menu a::after {
    display: none;
  }

  .nav .dd-menu a:hover {
    background: color-mix(in srgb, var(--violet) 8%, var(--surface));
    color: var(--link-text);
  }

  .right-controls {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .menu-toggle,
  .search-toggle,
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-strong);
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease, background var(--dur-fast) ease;
  }

  .menu-toggle:active,
  .search-toggle:active,
  .theme-toggle:active {
    background: var(--surface-secondary);
  }

  .menu-toggle {
    display: none;
  }

  .menu-toggle:hover,
  .search-toggle:hover,
  .theme-toggle:hover {
    color: var(--link-text);
    border-color: var(--line);
  }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .search-form {
    width: 0;
    overflow: hidden;
    opacity: 0;
    transition: width var(--dur-slow) var(--ease-standard), opacity var(--dur-normal) ease;
    /* Room for the focus ring, which overflow would otherwise clip. */
    margin: -4px;
    padding: 4px;
  }

  .search-wrap.open .search-form {
    width: 190px;
    opacity: 1;
  }

  .search-form input {
    width: 100%;
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: var(--surface);
    color: var(--ink);
  }

  .search-form input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .icon-sun {
      display: none;
    }
    :root:not([data-theme='light']) .theme-toggle .icon-moon {
      display: block;
    }
  }

  :root[data-theme='dark'] .theme-toggle .icon-sun {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle .icon-moon {
    display: block;
  }

  /* Drawer: floats under the bar (does not push the page) and fades/slides in. */
  .mobile-nav {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow-md);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity var(--dur-normal) ease, transform var(--dur-normal) var(--ease-standard), visibility 0s linear var(--dur-normal);
  }

  .mobile-nav.open {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  .nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9;
    background: rgb(var(--shadow-color) / 0.4);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-normal) ease, visibility 0s linear var(--dur-normal);
  }

  .nav-backdrop.open {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .mobile-nav a {
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    padding: 14px 24px;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .m-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 14px 24px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
    cursor: pointer;
  }

  .m-toggle svg {
    transition: transform var(--dur-normal) var(--ease-standard);
  }

  .m-group.open > .m-toggle {
    color: var(--ink-strong);
    box-shadow: inset 2px 0 0 var(--violet);
  }

  .m-group.open > .m-toggle svg {
    transform: rotate(180deg);
  }

  .m-subs {
    display: none;
    flex-direction: column;
  }

  .m-group.open > .m-subs {
    display: flex;
  }

  .mobile-nav a.sub {
    font-size: 0.72rem;
    padding-left: 44px;
  }

  .mobile-nav a.sub.all {
    color: var(--link-text);
  }

  .mobile-nav a.active {
    color: var(--ink-strong);
    box-shadow: inset 2px 0 0 var(--violet);
  }

  @media (max-width: 1160px) {
    .nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-nav {
      display: flex;
    }

    .search-wrap.open .search-form {
      width: 130px;
    }

    /* Menu à esquerda, logo centralizada, tema e busca à direita. */
    .bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 8px;
    }

    .menu-toggle {
      justify-self: start;
      margin-left: -8px;
    }

    .brand {
      justify-self: center;
    }

    .search-wrap {
      gap: 0;
    }

    .bar:has(.search-wrap.open) .brand {
      visibility: hidden;
    }

    .right-controls {
      justify-self: end;
      gap: 0;
      margin-right: -8px;
      position: relative;
      z-index: 1;
      background: var(--bg);
    }
  }

  @media (max-width: 400px) {
    .search-wrap.open .search-form {
      width: 100px;
    }
  }

  @media (max-width: 360px) {
    .brand-logo {
      height: 22px;
    }
  }
</style>
