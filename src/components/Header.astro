---
import { getCollection } from 'astro:content';
import { categories as categoryList } from '../data/categories';
import { themes, themeHref, matchesTheme, MIN_THEME_POSTS } from '../data/themes.mjs';
import { isPublished } from '../utils/posts';

const posts = await getCollection('blog', isPublished);

const categories = [
  { label: 'IA', category: 'Inteligência Artificial' },
  { label: 'Jogos', category: 'Jogos' },
  { label: 'Tutoriais', category: 'Tutoriais' },
  { label: 'Dicas', category: 'Dicas' },
  { label: 'Curiosidades', category: 'Curiosidades' },
  { label: 'Reviews', category: 'Reviews' },
  { label: 'Sistemas', category: 'Sistemas' },
  { label: 'Apps', category: 'Apps' },
  { label: 'Tendências', category: 'Tendências' },
  { label: 'Educação', category: 'Educação' },
];

// Subcategorias (temas) que abrem ao passar o mouse sobre a categoria.
const subsOf = (cat?: { subthemes?: string[] }) =>
  (cat?.subthemes ?? [])
    .map((s) => themes.find((x) => x.slug === s))
    .filter((x) => x && posts.filter((p) => matchesTheme(x, p.id, p.data.tags ?? [])).length >= MIN_THEME_POSTS)
    .map((x) => ({ label: x.name, href: themeHref(x.slug) }));

const nav = [
  { label: 'Início', href: '/', subs: [] },
  ...categories.map((c) => {
    const cat = categoryList.find((x) => x.name === c.category);
    return { label: c.label, href: `/categoria/${cat?.slug}/`, subs: subsOf(cat) };
  }),
];

const currentHref = Astro.url.pathname + Astro.url.search;
---
<header class="site-header">
  <div class="container bar">
    <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
    <a href="/" class="brand" aria-label="TechOnPlay - Início">
      <img class="brand-logo" src="/images/logo.webp" alt="TechOnPlay" width="197" height="30" />
    </a>
    <nav class="nav">
      {nav.map((item) =>
        item.subs.length ? (
          <div class="dd">
            <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
            <div class="dd-menu">
              {item.subs.map((s) => <a href={s.href}>{s.label}</a>)}
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
        ),
      )}
    </nav>
    <div class="right-controls">
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Alternar tema escuro">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <line x1="12" y1="2" x2="12" y2="4" />
          <line x1="12" y1="20" x2="12" y2="22" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="2" y1="12" x2="4" y2="12" />
          <line x1="20" y1="12" x2="22" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
      </button>
      <div class="search-wrap">
        <form class="search-form" action="/blog" method="get" id="search-form">
          <input type="search" name="q" placeholder="Buscar artigos…" aria-label="Buscar artigos" />
        </form>
        <button type="button" class="search-toggle" id="search-toggle" aria-label="Abrir busca" aria-expanded="false">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav">
    {nav.map((item) => (
      <>
        <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
        {item.subs.map((s) => <a href={s.href} class="sub">{s.label}</a>)}
      </>
    ))}
  </nav>
</header>

<script>
  const searchToggle = document.getElementById('search-toggle');
  const searchWrap = document.querySelector('.search-wrap');
  const searchInput = document.querySelector<HTMLInputElement>('.search-form input');

  searchToggle?.addEventListener('click', () => {
    const open = searchWrap?.classList.toggle('open');
    searchToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) searchInput?.focus();
  });

  const themeToggle = document.getElementById('theme-toggle');

  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const currentIsDark =
      root.getAttribute('data-theme') === 'dark' ||
      (!root.hasAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
    const next = currentIsDark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  menuToggle?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.remove('open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 64px;
    padding-block: 0;
    max-width: 1200px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .brand-logo {
    display: block;
    height: 30px;
    width: auto;
    max-width: none;
  }

  .nav {
    display: flex;
    align-items: stretch;
    align-self: stretch;
    gap: 0;
    flex: 1;
    justify-content: center;
  }

  .nav a {
    position: relative;
    display: flex;
    align-items: center;
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 0 9px;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 9px;
    right: 9px;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, var(--violet), var(--rose));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav a:hover,
  .nav a:focus-visible,
  .nav a.active {
    color: var(--ink-strong);
  }

  .nav a.active::after,
  .nav a:hover::after,
  .nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .dd {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .dd-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 240px;
    padding: 6px;
    flex-direction: column;
    gap: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 2px solid var(--violet);
    border-radius: 0 0 6px 6px;
    box-shadow: 0 12px 28px color-mix(in srgb, var(--ink-strong) 14%, transparent);
    z-index: 20;
  }

  .dd:hover .dd-menu,
  .dd:focus-within .dd-menu {
    display: flex;
  }

  .nav .dd-menu a {
    padding: 10px 12px;
    border-radius: 4px;
  }

  .nav .dd-menu a::after {
    display: none;
  }

  .nav .dd-menu a:hover {
    background: color-mix(in srgb, var(--violet) 8%, var(--surface));
    color: var(--link-text);
  }

  .right-controls {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .menu-toggle,
  .search-toggle,
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 4px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-strong);
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .menu-toggle {
    display: none;
  }

  .menu-toggle:hover,
  .search-toggle:hover,
  .theme-toggle:hover {
    color: var(--link-text);
    border-color: var(--line);
  }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .search-form {
    width: 0;
    overflow: hidden;
    opacity: 0;
    transition: width 0.2s ease, opacity 0.2s ease;
  }

  .search-wrap.open .search-form {
    width: 190px;
    opacity: 1;
  }

  .search-form input {
    width: 100%;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: var(--surface);
    color: var(--ink);
  }

  .search-form input:focus {
    border-color: var(--violet);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .icon-sun {
      display: none;
    }
    :root:not([data-theme='light']) .theme-toggle .icon-moon {
      display: block;
    }
  }

  :root[data-theme='dark'] .theme-toggle .icon-sun {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle .icon-moon {
    display: block;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid transparent;
    transition: max-height 0.25s ease;
  }

  .mobile-nav.open {
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    border-top-color: var(--line);
  }

  .mobile-nav a {
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 14px 24px;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .mobile-nav a.sub {
    font-size: 0.72rem;
    padding-left: 44px;
  }

  .mobile-nav a.active {
    color: var(--ink-strong);
    box-shadow: inset 2px 0 0 var(--violet);
  }

  @media (max-width: 1160px) {
    .nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-nav {
      display: flex;
    }

    .search-wrap.open .search-form {
      width: 130px;
    }

    /* Menu à esquerda, logo centralizada, tema e busca à direita. */
    .bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 8px;
    }

    .menu-toggle {
      justify-self: start;
      margin-left: -8px;
    }

    .brand {
      justify-self: center;
    }

    .search-wrap {
      gap: 0;
    }

    .bar:has(.search-wrap.open) .brand {
      visibility: hidden;
    }

    .right-controls {
      justify-self: end;
      gap: 0;
      margin-right: -8px;
      position: relative;
      z-index: 1;
      background: var(--bg);
    }
  }

  @media (max-width: 400px) {
    .search-wrap.open .search-form {
      width: 100px;
    }
  }

  @media (max-width: 360px) {
    .brand-logo {
      height: 22px;
    }
  }
</style>
