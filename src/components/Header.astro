---
import { categories as categoryList } from '../data/categories';

const categories = [
  { label: 'IA', category: 'Inteligência Artificial' },
  { label: 'Jogos', category: 'Jogos' },
  { label: 'Tutoriais', category: 'Tutoriais' },
  { label: 'Dicas', category: 'Dicas' },
  { label: 'Curiosidades', category: 'Curiosidades' },
  { label: 'Reviews', category: 'Reviews' },
  { label: 'Sistemas', category: 'Sistemas' },
  { label: 'Apps', category: 'Apps' },
  { label: 'Tendências', category: 'Tendências' },
  { label: 'Educação', category: 'Educação' },
];

const nav = [
  { label: 'Início', href: '/' },
  ...categories.map((c) => ({
    label: c.label,
    href: `/categoria/${categoryList.find((x) => x.name === c.category)?.slug}/`,
  })),
];

const currentHref = Astro.url.pathname + Astro.url.search;
---
<header class="site-header">
  <div class="container bar">
    <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
    <a href="/" class="brand" aria-label="TechOnPlay - Início">
      <img class="brand-logo" src="/images/logo.webp" alt="TechOnPlay" width="197" height="30" />
    </a>
    <nav class="nav">
      {nav.map((item) => (
        <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
      ))}
    </nav>
    <div class="right-controls">
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Alternar tema escuro">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <line x1="12" y1="2" x2="12" y2="4" />
          <line x1="12" y1="20" x2="12" y2="22" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="2" y1="12" x2="4" y2="12" />
          <line x1="20" y1="12" x2="22" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
      </button>
      <div class="search-wrap">
        <form class="search-form" action="/blog" method="get" id="search-form">
          <input type="search" name="q" placeholder="Buscar artigos…" aria-label="Buscar artigos" />
        </form>
        <button type="button" class="search-toggle" id="search-toggle" aria-label="Abrir busca" aria-expanded="false">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav">
    {nav.map((item) => (
      <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
    ))}
  </nav>
</header>

<script>
  const searchToggle = document.getElementById('search-toggle');
  const searchWrap = document.querySelector('.search-wrap');
  const searchInput = document.querySelector<HTMLInputElement>('.search-form input');

  searchToggle?.addEventListener('click', () => {
    const open = searchWrap?.classList.toggle('open');
    searchToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) searchInput?.focus();
  });

  const themeToggle = document.getElementById('theme-toggle');

  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const currentIsDark =
      root.getAttribute('data-theme') === 'dark' ||
      (!root.hasAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
    const next = currentIsDark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  menuToggle?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.remove('open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 16px;
    max-width: 1200px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .brand-logo {
    display: block;
    height: 30px;
    width: auto;
    max-width: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
    justify-content: center;
  }

  .nav a {
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 8px 10px;
    border-radius: 20px;
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: var(--violet-deep);
    background: color-mix(in srgb, var(--violet) 14%, transparent);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--violet) 22%, transparent);
    transform: translateY(-2px);
  }

  .nav a:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .nav a.active {
    color: var(--violet-deep);
    background: var(--line);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav a,
    .mobile-nav a {
      transition: none;
    }

    .nav a:hover,
    .nav a:focus-visible {
      transform: none;
    }
  }

  .right-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--ink-strong);
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-toggle:hover {
    color: var(--violet);
  }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .search-form {
    width: 0;
    overflow: hidden;
    opacity: 0;
    transition: width 0.2s ease, opacity 0.2s ease;
  }

  .search-wrap.open .search-form {
    width: 180px;
    opacity: 1;
  }

  .search-form input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 20px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    background: var(--surface);
    color: var(--ink);
  }

  .search-form input:focus {
    border-color: var(--violet);
  }

  .search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--ink-strong);
    cursor: pointer;
    flex-shrink: 0;
  }

  .search-toggle:hover {
    color: var(--violet);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--ink-strong);
    cursor: pointer;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--violet);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .icon-sun {
      display: none;
    }
    :root:not([data-theme='light']) .theme-toggle .icon-moon {
      display: block;
    }
  }

  :root[data-theme='dark'] .theme-toggle .icon-sun {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle .icon-moon {
    display: block;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid transparent;
    transition: max-height 0.25s ease;
  }

  .mobile-nav.open {
    max-height: 480px;
    border-top-color: var(--line);
  }

  .mobile-nav a {
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink-soft);
    padding: 14px 24px;
    border-bottom: 1px solid var(--line);
    transition: color 0.18s ease, background-color 0.18s ease, padding-left 0.18s ease;
  }

  .mobile-nav a:hover,
  .mobile-nav a:focus-visible {
    color: var(--violet-deep);
    background: color-mix(in srgb, var(--violet) 10%, transparent);
    padding-left: 32px;
  }

  .mobile-nav a.active {
    color: var(--violet-deep);
  }

  @media (max-width: 1160px) {
    .nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-nav {
      display: flex;
    }

    .search-wrap.open .search-form {
      width: 130px;
    }

    /* Mobile: menu button on the left, logo centered, theme and search on the right. */
    .bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 8px;
    }

    .menu-toggle {
      justify-self: start;
    }

    .brand {
      justify-self: center;
    }

    .brand-logo {
      height: 30px;
    }

    .theme-toggle,
    .search-toggle {
      width: 32px;
      height: 32px;
    }

    .search-wrap {
      gap: 0;
    }

    .bar:has(.search-wrap.open) .brand {
      visibility: hidden;
    }

    .right-controls {
      justify-self: end;
      gap: 0;
      position: relative;
      z-index: 1;
      background: var(--bg);
    }

  }

  @media (max-width: 400px) {
    .search-wrap.open .search-form {
      width: 100px;
    }
  }

  @media (max-width: 360px) {
    .brand-logo {
      height: 22px;
    }
  }
</style>
