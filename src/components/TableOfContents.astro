---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// Só as seções H2: o guia fica logo abaixo da capa, então precisa ser curto de ler.
const sections = Astro.props.headings.filter((h) => h.depth === 2);
const pad = (n: number) => String(n).padStart(2, '0');
---
{sections.length >= 3 && (
  <nav class="toc" id="toc" aria-labelledby="toc-title">
    <div class="toc-head">
      <h2 id="toc-title">Neste guia</h2>
      <span class="toc-count">{sections.length} seções</span>
      <button type="button" class="toc-toggle" id="toc-toggle" aria-controls="toc-list">
        <span class="toc-toggle-show">Mostrar</span>
        <span class="toc-toggle-hide">Ocultar</span>
      </button>
    </div>
    <ol class="toc-list" id="toc-list">
      {sections.map((s, i) => (
        <li><a href={`#${s.slug}`}><span class="toc-n">{pad(i + 1)}</span><span>{s.text}</span></a></li>
      ))}
    </ol>
  </nav>
)}

<script>
  const toc = document.getElementById('toc');
  const toggle = document.getElementById('toc-toggle');
  const list = document.getElementById('toc-list');

  if (toc && toggle && list) {
    const mobile = window.matchMedia('(max-width: 719px)');
    const setOpen = (open: boolean) => {
      toc.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    // Aberto no desktop, fechado no celular (o CSS já esconde a lista lá, então nada pula).
    toggle.setAttribute('aria-expanded', String(!mobile.matches));
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    list.addEventListener('click', (e) => {
      if (mobile.matches && (e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>

<style>
  /* Guia em caixa entre a capa e o texto, em todas as telas. */
  .toc {
    margin: 0 0 40px;
    padding: 18px 22px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    font-family: var(--font-body);
  }

  .toc-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .toc-head h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink-strong);
  }

  .toc-count {
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .toc-toggle {
    margin-left: auto;
    padding: 4px 12px;
    font: 600 0.78rem var(--font-body);
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }

  .toc-toggle:hover {
    border-color: var(--violet);
    color: var(--ink-strong);
  }

  .toc[data-open='true'] .toc-toggle-show,
  .toc[data-open='false'] .toc-toggle-hide {
    display: none;
  }

  .toc-list {
    list-style: none;
    margin: 14px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 28px;
  }

  .toc-list a {
    display: flex;
    gap: 10px;
    padding: 7px 0;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }

  .toc-n {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.75;
    color: var(--violet);
  }

  .toc-list a:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .toc[data-open='false'] .toc-list {
    display: none;
  }

  @media (min-width: 720px) {
    .toc:not([data-open]) .toc-toggle-show {
      display: none;
    }
  }

  /* Celular: uma coluna e fechado até o leitor pedir. */
  @media (max-width: 719px) {
    .toc {
      padding: 14px 18px;
      margin-bottom: 32px;
    }

    .toc-list {
      grid-template-columns: 1fr;
    }

    .toc:not([data-open='true']) .toc-list {
      display: none;
    }

    .toc:not([data-open]) .toc-toggle-hide {
      display: none;
    }
  }
</style>
