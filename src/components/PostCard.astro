---
import { categoryColor } from '../utils/categoryColor';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  date?: Date;
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  priority?: boolean;
}
const { slug, title, description, category, date, readingTime, image, imageAlt, priority = false } = Astro.props;

const formattedDate = date?.toLocaleDateString('pt-BR', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<a href={`/${slug}`} class="card">
  <div class="thumb">
    {image && <Image src={image} alt={imageAlt ?? title} width={480} height={320} quality={70} priority={priority} />}
    <span class="badge" style={`background:${categoryColor(category)}`}>{category}</span>
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p class="description">{description}</p>
    <span class="read-more">Ler mais »</span>
    {(formattedDate || readingTime) && (
      <p class="meta">
        {formattedDate}
        {formattedDate && readingTime && ' · '}
        {readingTime}
      </p>
    )}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(36, 30, 61, 0.06);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -12px rgba(36, 30, 61, 0.25);
  }

  .card:hover h3 {
    color: var(--violet);
  }

  .thumb {
    position: relative;
    aspect-ratio: 3 / 2;
    background: linear-gradient(135deg, var(--violet-soft), var(--rose-soft));
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(16, 10, 30, 0.65);
    backdrop-filter: blur(2px);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px 20px 20px;
  }

  h3 {
    font-size: 1.1rem;
    line-height: 1.3;
    margin: 0 0 8px;
    color: var(--ink-strong);
    transition: color 0.15s ease;
  }

  .description {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }

  .read-more {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--violet);
    margin-bottom: 12px;
  }

  .meta {
    margin: auto 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.78rem;
  }
</style>
