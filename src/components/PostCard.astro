---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CategoryLabel from './CategoryLabel.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  date?: Date;
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  priority?: boolean;
}
const { slug, title, description, category, date, readingTime, image, imageAlt, priority = false } = Astro.props;

const formattedDate = date?.toLocaleDateString('pt-BR', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<a href={`/${slug}`} class="card">
  <span class="thumb">
    {image && <Image src={image} alt={imageAlt ?? title} width={480} height={320} quality={70} priority={priority} />}
  </span>
  <span class="body">
    <CategoryLabel category={category} />
    <h3>{title}</h3>
    <p class="description">{description}</p>
    {(formattedDate || readingTime) && (
      <span class="meta">
        {formattedDate}{formattedDate && readingTime && ', '}{readingTime && `${readingTime} de leitura`}
      </span>
    )}
  </span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .thumb {
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: 10px;
    overflow: hidden;
    background: var(--line);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  h3 {
    font-size: 1.12rem;
    line-height: 1.28;
    letter-spacing: -0.015em;
    color: var(--ink-strong);
  }

  .card:hover h3 {
    color: var(--violet);
  }

  .description {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    margin-top: auto;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  /* Phones: compact rows with the picture beside the title, several posts per screen. */
  @media (max-width: 600px) {
    .card {
      flex-direction: row-reverse;
      align-items: flex-start;
      gap: 14px;
      padding-block: 16px;
      border-bottom: 1px solid var(--line);
    }

    .thumb {
      flex: none;
      width: 104px;
      aspect-ratio: 1;
      border-radius: 8px;
    }

    h3 {
      font-size: 1.02rem;
    }

    .description {
      display: none;
    }
  }
</style>
