---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CategoryLabel from './CategoryLabel.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  date?: Date;
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  priority?: boolean;
}
const { slug, title, description, category, date, readingTime, image, imageAlt, priority = false } = Astro.props;

const formattedDate = date?.toLocaleDateString('pt-BR', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<a href={`/${slug}`} class="card lift zoom">
  <span class="thumb">
    {image && <Image src={image} alt={imageAlt ?? title} width={480} height={320} quality={70} priority={priority} />}
  </span>
  <span class="body">
    <CategoryLabel category={category} />
    <h3>{title}</h3>
    <p class="description">{description}</p>
    {(formattedDate || readingTime) && (
      <span class="meta">
        {formattedDate}{formattedDate && readingTime && ', '}{readingTime && `${readingTime} de leitura`}
      </span>
    )}
  </span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    height: 100%;
    color: inherit;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur-normal) ease;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, var(--violet), var(--rose));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease-standard);
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  .card:hover::after {
    transform: scaleX(1);
  }

  .thumb {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(135deg, var(--violet-soft), var(--rose-soft));
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    padding: 16px 18px 18px;
  }

  h3 {
    font-size: 1.12rem;
    line-height: 1.28;
    letter-spacing: -0.015em;
    color: var(--ink-strong);
    transition: color var(--dur-normal) ease;
  }

  .card:hover h3 {
    color: var(--link-text);
  }

  .description {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    margin-top: auto;
    padding-top: 10px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Phones: compact rows with the picture beside the title, several posts per screen. */
  @media (max-width: 600px) {
    .card {
      flex-direction: row-reverse;
      align-items: flex-start;
      gap: 14px;
      padding-block: 16px;
      border: 0;
      border-bottom: 1px solid var(--line);
      border-radius: 0;
      background: transparent;
    }

    .card::after {
      display: none;
    }

    .card,
    .card:hover {
      transform: none;
      box-shadow: none;
    }

    .body {
      padding: 0;
    }

    .thumb {
      flex: none;
      width: 104px;
      aspect-ratio: 1;
      border: 0;
      border-radius: 6px;
    }

    h3 {
      font-size: 1.02rem;
    }

    .description {
      display: none;
    }
  }
</style>
