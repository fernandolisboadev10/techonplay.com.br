---
// Wordmark do TechOnPlay 2.0: "TechOn" + triângulo play + "Play". Texto vivo, sem imagem.
interface Props {
  onDark?: boolean;
  size?: number;
}
const { onDark = false, size = 25 } = Astro.props;
---
<span class:list={['logo', { 'on-dark': onDark }]} style={`--logo-size:${size}px`} aria-hidden="true">
  <span class="a">TechOn</span>
  <svg viewBox="0 0 20 22" focusable="false"><path d="M3 2 17 11 3 20Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" /></svg>
  <span class="b">Play</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--logo-size);
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }

  .a {
    color: #0f766e;
  }

  .b {
    color: var(--rose);
  }

  svg {
    width: 0.8em;
    height: 0.88em;
    margin: 0 3px;
    flex: none;
    color: var(--violet);
  }

  :global(:root[data-theme='dark']) .a {
    color: #2dd4bf;
  }

  :global(:root[data-theme='dark']) svg {
    color: #a78bfa;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .a {
      color: #2dd4bf;
    }

    :global(:root:not([data-theme='light'])) svg {
      color: #a78bfa;
    }
  }

  .on-dark .a {
    color: #2dd4bf;
  }

  .on-dark .b {
    color: #fb7185;
  }

  .on-dark svg {
    color: #a78bfa;
  }
</style>
