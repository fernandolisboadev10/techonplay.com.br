---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categoryColor } from '../utils/categoryColor';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
const [main, ...side] = posts;

const fmt = (d: Date) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
---
{main && (
  <div class="featured">
    <a href={`/${main.id}`} class="main">
      {main.data.image && <Image src={main.data.image} alt={main.data.imageAlt ?? main.data.title} width={960} height={640} quality={72} priority />}
      <div class="shade"></div>
      <div class="main-body">
        <span class="chip" style={`--chip:${categoryColor(main.data.category)}`}>{main.data.category}</span>
        <h3>{main.data.title}</h3>
        <p class="desc">{main.data.description}</p>
        <p class="by">Fernando Lisboa <span aria-hidden="true">•</span> {fmt(main.data.date)}</p>
      </div>
    </a>
    <div class="side">
      {side.map((p) => (
        <a href={`/${p.id}`} class="mini">
          <div class="mini-thumb">
            {p.data.image && <Image src={p.data.image} alt={p.data.imageAlt ?? p.data.title} width={640} height={360} quality={72} />}
            <span class="chip" style={`--chip:${categoryColor(p.data.category)}`}>{p.data.category}</span>
          </div>
          <div class="mini-body">
            <h3>{p.data.title}</h3>
            <p class="by">Fernando Lisboa <span aria-hidden="true">•</span> {fmt(p.data.date)}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
    gap: 24px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  .main {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 460px;
    border-radius: 20px;
    overflow: hidden;
    background: var(--ink-deep);
    color: #fff;
  }

  .main img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .main:hover img {
    transform: scale(1.03);
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 10, 30, 0) 30%, rgba(16, 10, 30, 0.92) 100%);
  }

  .main-body {
    position: relative;
    padding: 32px;
    max-width: 44rem;
  }

  .main h3 {
    margin: 14px 0 10px;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.12;
    color: #fff;
  }

  .desc {
    margin: 0 0 14px;
    color: rgba(255, 255, 255, 0.82);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .by {
    margin: 0;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .main .by {
    color: rgba(255, 255, 255, 0.78);
  }

  .by span {
    margin: 0 4px;
  }

  .side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 24px;
  }

  .mini {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mini-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--violet-soft), var(--rose-soft));
  }

  .mini-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .mini:hover .mini-thumb img {
    transform: scale(1.04);
  }

  .mini-thumb .chip {
    position: absolute;
    top: 12px;
    left: 12px;
  }

  .mini-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mini h3 {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--ink-strong);
    transition: color 0.15s ease;
  }

  .mini:hover h3 {
    color: var(--violet);
  }

  .chip {
    align-self: flex-start;
    padding: 5px 10px;
    border-radius: 8px;
    background: var(--chip, var(--violet-deep));
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .main {
      min-height: 380px;
    }

    .side {
      grid-template-rows: none;
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .main-body {
      padding: 22px;
    }

    .side {
      grid-template-columns: 1fr;
    }
  }
</style>
