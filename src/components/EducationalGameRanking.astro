---
import { gameHref } from '../data/educationalGames';
import { loadEducationalGameRanking } from '../data/educationalGameRanking';

const ranking = await loadEducationalGameRanking();
const updated = new Date();
const updatedLabel = new Intl.DateTimeFormat('pt-BR', {
  dateStyle: 'short',
  timeStyle: 'short',
  timeZone: 'America/Sao_Paulo',
}).format(updated);
---
<section class="ranking" aria-labelledby="ranking-title">
  <h3 id="ranking-title">Ranking dos jogos</h3>
  {ranking === null ? (
    <p>A apuração geral ainda está indisponível.</p>
  ) : (
    <>
      {ranking.length ? (
        <ol role="list" class="positions">
          {ranking.map(({ slug, title, votes, position }) => (
            <li class:list={{ leading: position <= 3 }}>
              <span class="position" aria-label={`${position}º lugar`}>{position}º</span>
              <a href={gameHref(slug)}>{title}</a>
              <span class="votes">{votes.toLocaleString('pt-BR')} {votes === 1 ? 'voto' : 'votos'}</span>
            </li>
          ))}
        </ol>
      ) : <p>Ainda não há votos apurados.</p>}
      <p class="updated">Apuração de <time datetime={updated.toISOString()}>{updatedLabel}</time></p>
    </>
  )}
</section>

<style>
  .ranking {
    align-self: start;
    min-width: 0;
    padding: clamp(14px, 2.6vw, 22px);
    border: 1px solid #483960;
    border-radius: 12px;
    background: #21182f;
  }
  h3 { margin: 0; color: #fff; font-size: 1.3rem; }
  p { margin: 9px 0 0; color: var(--muted); }
  .positions { display: grid; gap: 8px; list-style: none; margin: 13px 0 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border: 1px solid var(--edge);
    border-radius: 8px;
    background: #191226;
    font-size: .9rem;
  }
  .leading { border-color: #756645; }
  .position {
    color: var(--muted);
    font-weight: 800;
    text-align: center;
  }
  .leading .position, .leading .votes { color: var(--lime); }
  a { color: #f8f5ff; text-decoration: none; font-weight: 650; overflow-wrap: anywhere; }
  a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px; }
  .votes { color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .updated { margin-top: 12px; font-size: .8rem; }
</style>
