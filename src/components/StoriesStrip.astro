---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';

const stories = (await getCollection('stories', (s) => !s.data.draft && s.data.date.getTime() <= Date.now()))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 8);
---
{stories.length > 0 && (
  <section class="container stories" aria-labelledby="stories-title">
    <SectionHead title="Web Stories" id="stories-title" />
    <ul>
      {stories.map((s) => (
        <li>
          <a href={`/web-stories/${s.id}/`} class="story lift" style={`background-image:url('${s.data.poster}')`}>
            <span class="shade"></span>
            <span class="body">
              <strong>{s.data.title}</strong>
              <span class="foot">
                <small>{s.data.pages.length + 2} páginas</small>
                <span class="arrow" aria-hidden="true">→</span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .stories {
    padding-block: 8px 48px;
  }

  ul {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  ul::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 600px) {
    ul {
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--space-lg);
      margin-inline: calc(var(--space-lg) * -1);
      padding-inline: var(--space-lg);
    }
  }

  li {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .story {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 200px;
    aspect-ratio: 3 / 4;
    padding: 14px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--ink-deep) center / cover no-repeat;
    color: #fff;
    text-decoration: none;

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 10, 30, 0.25) 0%, rgba(16, 10, 30, 0) 30%, rgba(16, 10, 30, 0.9) 100%);
  }

  .body {
    position: relative;
  }

  .body strong {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 1rem;
    line-height: 1.25;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
  }

  small {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.6);
  }
</style>
