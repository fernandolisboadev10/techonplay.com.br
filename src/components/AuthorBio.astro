---
import { socials } from '../data/socials';
---
<aside class="author-bio">
  <img
    src="/images/fernando-lisboa.png"
    alt="Fernando Lisboa"
    class="author-photo"
    width="72"
    height="72"
    loading="lazy"
  />
  <div class="author-body">
    <p class="author-name">Fernando Lisboa</p>
    <p>
      Analista de sistemas independente e redator de tecnologia, apaixonado
      por IA e robótica. Criei o TechOnPlay para separar o que é útil do que
      é ruído.
    </p>
    <ul class="author-social" aria-label="Redes sociais de Fernando Lisboa">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer me">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .author-bio {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .author-photo {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-name {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink-strong);
  }

  .author-body {
    min-width: 0;
  }

  @media (max-width: 600px) {
    .author-bio {
      align-items: flex-start;
    }
  }

  .author-social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin: 12px 0 0;
    padding: 0;
  }

  .author-social a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .author-social a:hover {
    color: var(--teal);
  }

  .author-body p:not(.author-name) {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
</style>
