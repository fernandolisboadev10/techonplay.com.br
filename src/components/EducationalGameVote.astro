---
import { educationalGames } from '../data/educationalGames';

const initialVotes: Partial<Record<string, number>> = { 'neon-rails': 1 };
---
<section id="votacao" class="game-vote" aria-labelledby="vote-title">
  <h2 id="vote-title">Qual foi o melhor jogo?</h2>
  <p>Vote no seu favorito. Os totais são salvos neste navegador, com um voto por sessão.</p>
  <form data-game-vote hidden>
    <fieldset>
      <legend class="sr-only">Escolha um jogo</legend>
      <div class="choices">
        {educationalGames.map((game) => {
          const initial = initialVotes[game.slug] ?? 0;
          return (
            <label>
              <input type="radio" name="game" value={game.slug} required />
              <span data-game-name>{game.title}</span>
              <span class="vote-count" data-vote-count={game.slug} data-initial-votes={initial}>
                {initial} {initial === 1 ? 'voto' : 'votos'}
              </span>
            </label>
          );
        })}
      </div>
    </fieldset>
    <button type="submit" disabled>Confirmar voto</button>
  </form>
  <p data-vote-status role="status"></p>
  <noscript><p>Ative o JavaScript para votar.</p></noscript>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-game-vote]');
  const status = document.querySelector<HTMLElement>('[data-vote-status]');

  if (form && status) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const fieldset = form.querySelector('fieldset')!;
    const choices = [...form.querySelectorAll<HTMLInputElement>('input[name="game"]')];
    const counters = [...form.querySelectorAll<HTMLElement>('[data-vote-count]')];
    const cookieName = 'techonplay_arcade_vote';
    const totalsKey = 'techonplay_arcade_vote_totals';
    const pagePath = '/categoria/jogos/jogos-educativos/';
    let pending = false;

    function getVote() {
      const prefix = `${cookieName}=`;
      const value = document.cookie.split('; ').find((cookie) => cookie.startsWith(prefix))?.slice(prefix.length);
      return choices.find((choice) => choice.value === value);
    }

    function getTotals(): Record<string, number> {
      try {
        const totals = JSON.parse(localStorage.getItem(totalsKey) ?? '{}');
        return totals && typeof totals === 'object' && !Array.isArray(totals) ? totals : {};
      } catch {
        return {};
      }
    }

    function localCount(totals: Record<string, number>, slug: string) {
      const count = totals[slug];
      return Number.isSafeInteger(count) && count >= 0 ? count : 0;
    }

    function renderTotals() {
      const totals = getTotals();
      counters.forEach((counter) => {
        const count = Number(counter.dataset.initialVotes) + localCount(totals, counter.dataset.voteCount!);
        counter.textContent = `${count.toLocaleString('pt-BR')} ${count === 1 ? 'voto' : 'votos'}`;
      });
    }

    function refresh() {
      renderTotals();
      const vote = getVote();
      if (vote) {
        vote.checked = true;
        const game = vote.labels?.[0]?.querySelector('[data-game-name]')?.textContent;
        status!.textContent = `Você votou em ${game} nesta sessão.`;
      }
      fieldset.disabled = Boolean(vote);
      button.disabled = pending || Boolean(vote) || !choices.some((choice) => choice.checked);
      button.hidden = Boolean(vote);
    }

    function voteFor(choice: HTMLInputElement) {
      if (getVote()) return;
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      const cookieOptions = `Path=${pagePath}; SameSite=Lax${secure}`;
      document.cookie = `${cookieName}=${choice.value}; ${cookieOptions}`;
      if (!getVote()) {
        status!.textContent = 'Permita os cookies do site para votar nesta sessão.';
        return;
      }
      try {
        const totals = getTotals();
        totals[choice.value] = localCount(totals, choice.value) + 1;
        localStorage.setItem(totalsKey, JSON.stringify(totals));
      } catch {
        document.cookie = `${cookieName}=; ${cookieOptions}; Max-Age=0`;
        status!.textContent = 'O navegador bloqueou o armazenamento do voto. Tente novamente após habilitá-lo.';
      }
    }

    form.addEventListener('change', refresh);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const choice = choices.find((option) => option.checked);
      if (pending || !choice) return;
      pending = true;
      refresh();
      try {
        if (navigator.locks) await navigator.locks.request(cookieName, () => voteFor(choice));
        else voteFor(choice);
      } finally {
        pending = false;
        refresh();
      }
    });
    window.addEventListener('pageshow', refresh);
    window.addEventListener('storage', (event) => { if (event.key === totalsKey || event.key === null) refresh(); });
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
    form.hidden = false;
    refresh();
  }
</script>

<style>
  .game-vote {
    margin-top: 54px;
    padding: clamp(18px, 4vw, 36px);
    scroll-margin-top: 90px;
    background: #191226;
    border: 1px solid var(--edge);
    border-radius: 18px;
  }
  h2 { margin: 0; color: #fff; font-size: clamp(1.75rem, 4vw, 2.45rem); letter-spacing: -.04em; }
  p { margin: 6px 0 0; color: var(--muted); }
  fieldset { margin: 20px 0 0; padding: 0; border: 0; min-inline-size: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  label {
    min-height: 46px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border: 1px solid #483960;
    border-radius: 8px;
    color: #f8f5ff;
    background: #21182f;
    cursor: pointer;
  }
  fieldset:disabled label { cursor: default; }
  input { flex: none; width: 18px; height: 18px; margin: 0; accent-color: var(--lime); }
  .vote-count {
    flex: none;
    margin-left: auto;
    padding: 2px 8px;
    border-radius: 999px;
    background: #342943;
    color: var(--lime);
    font-size: .85rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  label:is(:has(:checked), :focus-within), fieldset:enabled label:hover { border-color: var(--lime); }
  label:has(:checked) { background: #30283c; }
  button {
    min-height: 44px;
    margin-top: 18px;
    padding: 8px 16px;
    border: 0;
    border-radius: 8px;
    color: #17141e;
    background: var(--lime);
    font: inherit;
    font-weight: 750;
    cursor: pointer;
  }
  button:disabled { opacity: .55; cursor: default; }
  button:focus-visible { outline: 2px solid var(--lime); outline-offset: 4px; }
  [hidden], [data-vote-status]:empty { display: none; }
  [data-vote-status] { margin-top: 14px; color: var(--lime); }
  @media (max-width: 670px) { .choices { grid-template-columns: 1fr; } }
</style>
