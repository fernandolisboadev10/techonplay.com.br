---
import { categoryColor } from '../utils/categoryColor';

interface Props {
  category: string;
  onImage?: boolean;
}
const { category, onImage = false } = Astro.props;
---
<span class:list={['cat', { 'on-image': onImage }]} style={`--cat:${categoryColor(category)}`}>{category}</span>

<style>
  /* Categoria em mono maiúsculo, com um quadrado de cor: legível sobre qualquer fundo. */
  .cat {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    color: var(--violet-deep);
  }

  :global(:root[data-theme='dark']) .cat {
    color: var(--violet-soft);
  }

  .cat::before {
    content: '';
    flex: none;
    width: 8px;
    height: 9px;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    background: var(--cat);
  }

  .on-image {
    color: rgba(255, 255, 255, 0.92);
  }

  .on-image::before {
    background: color-mix(in srgb, var(--cat) 55%, #fff);
  }

  :global(:root[data-theme='dark']) .cat::before {
    background: color-mix(in srgb, var(--cat) 60%, #fff);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .cat::before {
      background: color-mix(in srgb, var(--cat) 60%, #fff);
    }
  }
</style>
