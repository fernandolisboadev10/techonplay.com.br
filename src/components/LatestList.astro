---
import type { CollectionEntry } from 'astro:content';
import { activityTime } from '../utils/posts';
import CategoryLabel from './CategoryLabel.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

const MONTHS = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];

// Day and Brasília time of the post's latest activity. Posts dated without a time (midnight UTC)
// show only the day, read in UTC so it does not slip to the previous evening.
const stamp = (post: CollectionEntry<'blog'>) => {
  const t = new Date(activityTime(post));
  const dateOnly = t.getUTCHours() === 0 && t.getUTCMinutes() === 0;
  const local = dateOnly ? t : new Date(t.getTime() - 3 * 60 * 60 * 1000);
  const day = `${local.getUTCDate()} ${MONTHS[local.getUTCMonth()]}`;
  const time = dateOnly ? '' : `${String(local.getUTCHours()).padStart(2, '0')}:${String(local.getUTCMinutes()).padStart(2, '0')}`;
  return { iso: t.toISOString(), day, time };
};
---
<ol class="latest">
  {posts.map((p) => {
    const s = stamp(p);
    return (
      <li>
        <a href={`/${p.id}`}>
          <time datetime={s.iso}>
            <span class="day">{s.day}</span>
            {s.time && <span class="time">{s.time}</span>}
          </time>
          <span class="body">
            <CategoryLabel category={p.data.category} />
            <span class="title">{p.data.title}</span>
          </span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  /* Same rail as the post guide: one node per post, newest at the top. */
  .latest {
    --stamp: 52px;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .latest::before {
    content: '';
    position: absolute;
    left: calc(var(--stamp) + 15px);
    top: 14px;
    bottom: 14px;
    width: 2px;
    border-radius: 2px;
    background: var(--line);
  }

  li a {
    position: relative;
    display: grid;
    grid-template-columns: var(--stamp) minmax(0, 1fr);
    column-gap: 32px;
    padding: 9px 0;
    color: inherit;
    text-decoration: none;
  }

  li a::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: calc(var(--stamp) + 10px);
    top: 15px;
    width: 12px;
    height: 12px;
    box-sizing: border-box;
    border-radius: 50%;
    border: 2px solid var(--line);
    background: var(--bg);
  }

  li:first-child a::before {
    border-color: var(--violet);
    background: var(--violet);
  }

  time {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  .day {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--ink);
  }

  .time {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-soft);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink-strong);
  }

  li a:hover .title {
    color: var(--link-text);
  }

  li a:hover::before {
    border-color: var(--violet);
  }
</style>
