---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  id?: string;
}
const { title, href, linkLabel, id } = Astro.props;
---
<div class="section-head">
  <h2 id={id}>{href ? <a href={href}>{title}</a> : title}</h2>
  <span class="rule" aria-hidden="true"></span>
  {href && linkLabel && <a class="more" href={href}>{linkLabel}</a>}
</div>

<style>
  .section-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
  }

  h2 {
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--link-text);
  }

  /* A linha separa as seções e leva o olho até o link da seção. */
  .rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .more {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    color: var(--link-text);
  }
</style>
