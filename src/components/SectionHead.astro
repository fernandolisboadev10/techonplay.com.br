---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  id?: string;
}
const { title, href, linkLabel, id } = Astro.props;
---
<div class="section-head">
  <h2 id={id}>{href ? <a href={href}>{title}</a> : title}</h2>
  <span class="rule" aria-hidden="true"></span>
  {href && linkLabel && <a class="more" href={href}>{linkLabel}</a>}
</div>

<style>
  .section-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  h2::before {
    content: '';
    flex: none;
    width: 12px;
    height: 14px;
    background: var(--rose);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--link-text);
  }

  /* A linha separa as seções e leva o olho até o link da seção. */
  .rule {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }

  .more {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--violet-deep);
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    color: var(--link-text);
  }
</style>
