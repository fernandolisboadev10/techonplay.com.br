---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  id?: string;
}
const { title, href, linkLabel, id } = Astro.props;
---
<div class="section-head">
  <h2 id={id}>{href ? <a href={href}>{title}</a> : title}</h2>
  <span class="rule" aria-hidden="true"></span>
  {href && linkLabel && <a class="more" href={href}>{linkLabel}</a>}
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 20px;
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--violet);
  }

  /* The rule separates sections and carries the eye to the section link. */
  .rule {
    flex: 1;
    align-self: center;
    height: 1px;
    background: var(--line);
  }

  .more {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--violet);
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
