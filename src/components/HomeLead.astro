---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import CategoryLabel from './CategoryLabel.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const [main, ...side] = Astro.props.posts;
---
{main && (
  <div class="lead">
    <a href={`/${main.id}`} class="top zoom">
      <span class="top-media">
        {main.data.image && <Image src={main.data.image} alt={main.data.imageAlt ?? main.data.title} width={960} height={600} quality={72} priority />}
      </span>
      <span class="top-body rise">
        <CategoryLabel category={main.data.category} />
        <h2><span class="link-title">{main.data.title}</span></h2>
        <p>{main.data.description}</p>
      </span>
    </a>
    {side.length > 0 && (
      <div class="seconds">
        {side.map((p) => (
          <a href={`/${p.id}`} class="second zoom">
            <span class="thumb">
              {p.data.image && <Image src={p.data.image} alt={p.data.imageAlt ?? p.data.title} width={480} height={300} quality={70} />}
            </span>
            <span class="second-body">
              <CategoryLabel category={p.data.category} />
              <h3>{p.data.title}</h3>
            </span>
          </a>
        ))}
      </div>
    )}
  </div>
)}

<style>
  a {
    color: inherit;
    text-decoration: none;
  }

  .top {
    display: flex;
    flex-direction: column;
    color: inherit;
  }

  .top-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-2);
  }

  .top img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: settle 700ms var(--ease-standard) both;
  }

  /* Headline block rises in once; the image is never faded (LCP). */
  .rise > :nth-child(1) { animation: rise 450ms var(--ease-standard) 80ms both; }
  .rise > :nth-child(2) { animation: rise 450ms var(--ease-standard) 140ms both; }
  .rise > :nth-child(3) { animation: rise 450ms var(--ease-standard) 200ms both; }

  .top-body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 0 0;
    max-width: 44rem;
  }

  .top h2 {
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.02;
    color: var(--ink-strong);
  }

  .top h2 {
    text-wrap: balance;
  }

  .top p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.15rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .seconds {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 24px;
  }

  .second {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--line);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .second-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .second h3 {
    font-size: 1.15rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .second h3 {
    transition: color var(--dur-normal) ease;
  }

  .second:hover h3 {
    color: var(--link-text);
  }

  @media (max-width: 640px) {
    .top-media {
      aspect-ratio: 4 / 3;
    }

    /* Secondary stories become compact rows on phones. */
    .seconds {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 8px;
    }

    .second {
      flex-direction: row-reverse;
      align-items: flex-start;
      padding-block: 16px;
      border-bottom: 1px solid var(--line);
    }

    .thumb {
      flex: none;
      width: 104px;
      aspect-ratio: 1;
      border-radius: 6px;
    }

    .second-body {
      flex: 1;
    }

    .second h3 {
      font-size: 1.02rem;
    }
  }
</style>
