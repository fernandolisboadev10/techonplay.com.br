---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';

interface Props {
  name: string;
  href: string;
  total: number;
  posts: CollectionEntry<'blog'>[];
}
const { name, href, total, posts } = Astro.props;
const [first, ...rest] = posts;
---
<section class="block">
  <SectionHead title={name} href={href} linkLabel={`Ver os ${total} posts`} />
  <a href={`/${first.id}`} class="first">
    <span class="thumb">
      {first.data.image && <Image src={first.data.image} alt={first.data.imageAlt ?? first.data.title} width={560} height={315} quality={70} />}
    </span>
    <h3>{first.data.title}</h3>
    <p>{first.data.description}</p>
  </a>
  <ul>
    {rest.map((p) => (
      <li>
        <a href={`/${p.id}`}>
          <span class="mini">
            {p.data.image && <Image src={p.data.image} alt="" width={160} height={160} quality={65} />}
          </span>
          <h3>{p.data.title}</h3>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  a {
    color: inherit;
    text-decoration: none;
  }

  .first {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: var(--line);
  }

  .thumb img,
  .mini img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .first h3 {
    margin-top: 4px;
    font-size: 1.2rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .first p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }

  li a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }

  .mini {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--line);
  }

  li h3 {
    font-size: 0.98rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  a:hover h3 {
    color: var(--link-text);
  }
</style>
