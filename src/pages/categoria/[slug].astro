---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories } from '../../data/categories';
import { themes, matchesTheme, MIN_THEME_POSTS, themeHref } from '../../data/themes.mjs';
import { isPublished, sortByActivity } from '../../utils/posts';

export async function getStaticPaths() {
  const all = sortByActivity(await getCollection('blog', isPublished));
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      posts: all.filter((p) => p.data.category === category.name),
      subs: (category.subthemes ?? [])
        .map((s) => themes.find((t) => t.slug === s))
        .filter((t) => t)
        .map((t) => ({ name: t.name, href: themeHref(t.slug), count: all.filter((p) => matchesTheme(t, p.id, p.data.tags ?? [])).length }))
        .filter((s) => s.count >= MIN_THEME_POSTS),
    },
  }));
}

const PAGE_SIZE = 6;
const { category, posts, subs } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: category.title,
  description: category.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: 'pt-BR',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/${p.id}/`, Astro.site).toString(),
      name: p.data.title,
    })),
  },
};
---
<BaseLayout
  title={category.title}
  description={category.description}
  image={posts[0]?.data.image?.src}
  noindex={posts.length < 2}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="container">
    <header class="page-header">
      <p class="crumbs"><a href="/blog/">Blog</a> / {category.name}</p>
      <h1>{category.name}</h1>
      <p>{category.intro}</p>
    </header>

    {subs.length > 0 && (
      <nav class="subs" aria-label="Subcategorias">
        {subs.map((s) => <a href={s.href}>{s.name} <span>{s.count}</span></a>)}
      </nav>
    )}

    <div class="posts">
      {posts.map((post, i) => (
        <div class={i < PAGE_SIZE ? 'item' : 'item extra'}>
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
        />
        </div>
      ))}
    </div>
    <div class="more-wrap">
      <a href="/blog/" id="more-posts" class="more-btn" data-step={PAGE_SIZE}>Ver mais posts</a>
    </div>

    <nav class="other" aria-label="Outras categorias">
      {categories
        .filter((c) => c.slug !== category.slug)
        .map((c) => <a href={`/categoria/${c.slug}/`}>{c.name}</a>)}
    </nav>
  </div>
</BaseLayout>

<script>
  // Reveals the next batch of this category's posts; once none are left the button is a plain link to the blog.
  const btn = document.querySelector<HTMLAnchorElement>('#more-posts');
  btn?.addEventListener('click', (event) => {
    const step = Number(btn.dataset.step) || 6;
    const hidden = document.querySelectorAll<HTMLElement>('.item.extra:not(.show)');
    if (!hidden.length) return;
    event.preventDefault();
    hidden.forEach((el, i) => {
      if (i < step) el.classList.add('show');
    });
  });
</script>

<style>
  .subs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 24px;
  }

  .subs a {
    font-size: 0.9rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 20px;
    border: 1px solid var(--violet);
    color: var(--violet);
    text-decoration: none;
  }

  .subs a span {
    color: var(--ink-soft);
    font-weight: 400;
  }

  .subs a:hover {
    background: var(--violet);
    color: #fff;
  }

  .subs a:hover span {
    color: #fff;
  }

  .item {
    display: contents;
  }

  .item.extra:not(.show) {
    display: none;
  }

  .page-header {
    padding-block: 48px 24px;
    max-width: 60ch;
  }

  .crumbs {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0 0 8px;
  }

  .crumbs a {
    color: var(--violet);
    text-decoration: none;
  }

  .page-header p:not(.crumbs) {
    color: var(--ink-soft);
    margin-top: 8px;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding-bottom: 16px;
  }

  @media (max-width: 860px) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }

  .more-wrap {
    display: flex;
    justify-content: center;
    margin-block: 24px 40px;
  }

  .more-btn {
    display: inline-block;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 28px;
    border-radius: 999px;
    border: 0;
    color: #fff;
    cursor: pointer;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .more-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .other {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-block: 24px 48px;
  }

  .other a {
    font-size: 0.85rem;
    padding: 8px 14px;
    border-radius: 20px;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    text-decoration: none;
  }

  .other a:hover {
    color: var(--violet);
    border-color: var(--violet);
  }
</style>
