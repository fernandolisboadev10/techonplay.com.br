---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { educationalGames, educationalGamesHref, gameFile, gameCover, gameSubjects } from '../../../../data/educationalGames';

export function getStaticPaths() {
  return educationalGames.map((game) => ({
    params: { jogo: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const src = gameFile(game.slug);
const subject = gameSubjects[game.subject];
---
<BaseLayout title={game.title} seoTitle={`${game.title} · Jogos Educativos | TechOnPlay`} description={game.description} image={gameCover(game.slug)}>
  <div class="game">
    <div class="container">
      <a class="back" href={educationalGamesHref}><span aria-hidden="true">←</span> Jogos Educativos</a>
      <header class="game-header">
        <div>
          <p class="subject" style={`--accent: ${subject.color}`}>{subject.label}</p>
          <h1>{game.title}</h1>
          <p class="description">{game.description}</p>
        </div>
        <div class="actions">
          <button type="button" data-fullscreen aria-pressed="false" hidden>Tela cheia</button>
          <a href={src}>Abrir só o jogo</a>
        </div>
      </header>
      <div class="stage" data-stage>
        <div class="fullscreen-bar">
          <button type="button" data-exit>← Sair da tela cheia</button>
        </div>
        <iframe src={src} title={game.title} allow="autoplay; fullscreen"></iframe>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const button = document.querySelector<HTMLButtonElement>('[data-fullscreen]');
  const exit = document.querySelector<HTMLButtonElement>('[data-exit]');
  if (stage && button && exit && document.fullscreenEnabled) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try { await stage.requestFullscreen(); exit.focus(); } catch {}
    });
    exit.addEventListener('click', async () => {
      if (document.fullscreenElement === stage) await document.exitFullscreen();
    });
    document.addEventListener('fullscreenchange', () => {
      const playing = document.fullscreenElement === stage;
      button.setAttribute('aria-pressed', String(playing));
      if (!playing) button.focus();
    });
  }
</script>

<style>
  .game { color-scheme: dark; color: #f8f5ff; background: radial-gradient(ellipse at 80% 0, #241442, transparent 35rem), #0d0a17; padding-block: 26px 48px; }
  .back { display: inline-flex; gap: 8px; align-items: center; color: #d8fd76; font-weight: 650; text-decoration: none; }
  .back:hover { text-decoration: underline; }
  .game-header { display: flex; flex-wrap: wrap; gap: 16px; align-items: end; justify-content: space-between; margin-block: 22px 16px; }
  .game-header h1 { color: #fff; font-size: clamp(2rem, 5vw, 3.65rem); letter-spacing: -.055em; line-height: 1.1; margin: 6px 0; }
  .subject { color: var(--accent); font: 650 .82rem var(--font-mono), monospace; margin: 0; }
  .description { color: #c1b9d6; margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .actions button, .actions a, .fullscreen-bar button { color: #f8f5ff; background: #251a3a; border: 1px solid #52406d; border-radius: 8px; min-height: 44px; padding: 9px 14px; font: 650 .88rem var(--font-body), sans-serif; cursor: pointer; text-decoration: none; }
  .actions a { display: inline-flex; align-items: center; }
  .actions button:hover, .actions a:hover, .fullscreen-bar button:hover { border-color: #d8fd76; }
  .game :is(a, button):focus-visible { outline: 2px solid #d8fd76; outline-offset: 4px; }
  .stage { overflow: hidden; background: #171021; border: 1px solid #52406d; border-radius: 14px; }
  .stage iframe { display: block; width: 100%; height: clamp(590px, 79dvh, 950px); border: 0; }
  .fullscreen-bar { display: none; }
  .stage:fullscreen { display: flex; flex-direction: column; border: 0; border-radius: 0; }
  .stage:fullscreen .fullscreen-bar { display: flex; padding: 4px 12px; justify-content: end; }
  .stage:fullscreen iframe { flex: 1; height: auto; min-height: 0; }
  @media (max-width: 560px) { .stage iframe { height: max(540px, 78dvh); } }
</style>
