---
import { getCollection } from 'astro:content';
import { isPublished, sortByActivity } from '../../utils/posts';
import Home from '../index.astro';

export async function getStaticPaths() {
  const PER_PAGE = 9;
  const all = sortByActivity(await getCollection('blog', isPublished));
  const total = Math.ceil((all.length - 3) / PER_PAGE);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2 },
  }));
}

const { page } = Astro.props;
---
<Home page={page} />
