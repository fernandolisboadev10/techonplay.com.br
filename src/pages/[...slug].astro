---
import { getCollection, render } from 'astro:content';
import { isPublished, sortByActivity } from '../utils/posts';
import PostLayout from '../layouts/PostLayout.astro';

export async function getStaticPaths() {
  // Same order as the home feed, newest first: "previous" is the older post, "next" the newer one.
  const posts = sortByActivity(await getCollection('blog', isPublished));
  const link = (p?: (typeof posts)[number]) => (p ? { slug: p.id, title: p.data.title } : undefined);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: link(posts[i + 1]), next: link(posts[i - 1]) },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---
<PostLayout
  title={post.data.title}
  description={post.data.description}
  category={post.data.category}
  date={post.data.date}
  updated={post.data.updated}
  related={post.data.related}
  tags={post.data.tags}
  slug={post.id}
  readingTime={post.data.readingTime}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  prev={prev}
  next={next}
  headings={headings}
>
  <Content />
</PostLayout>
