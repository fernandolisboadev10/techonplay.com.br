---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { isPublished, sortByActivity } from '../../utils/posts';

const posts = sortByActivity(await getCollection('blog', isPublished));

const categories = [
  'Inteligência Artificial',
  'Jogos',
  'Tutoriais',
  'Dicas',
  'Curiosidades',
  'Reviews',
  'Apps',
  'Tendências',
];
---
<BaseLayout title="Blog" description="Guias, reviews e notícias sobre IA, jogos, tutoriais e curiosidades.">
  <div class="container">
    <header class="page-header">
      <h1>Blog</h1>
      <p>Guias, reviews e notícias sobre IA, jogos, tutoriais e curiosidades.</p>
    </header>

    <input
      type="search"
      id="search-input"
      class="search-input"
      placeholder="Buscar artigos…"
      aria-label="Buscar artigos"
    />

    <div class="filters" id="filters">
      <button class="filter active" data-category="all">Todos</button>
      {categories.map((c) => (
        <button class="filter" data-category={c}>{c}</button>
      ))}
    </div>

    <div class="posts" id="posts">
      {posts.map((post) => (
        <div
          class="post-item"
          data-category={post.data.category}
          data-search={`${post.data.title} ${post.data.description}`.toLowerCase()}
        >
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            date={post.data.date}
            readingTime={post.data.readingTime}
            image={post.data.image}
            imageAlt={post.data.imageAlt}
          />
        </div>
      ))}
    </div>

    <div class="more-wrap" id="more-wrap" hidden>
      <button type="button" id="more-posts" class="more-btn">Ver mais posts</button>
    </div>

    <p class="no-results" id="no-results" hidden>Nenhum artigo corresponde à sua busca.</p>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-block: 48px 24px;
    max-width: 60ch;
  }

  .page-header p {
    color: var(--ink-soft);
    margin-top: 8px;
  }

  .search-input {
    display: block;
    width: 100%;
    max-width: 360px;
    padding: 10px 16px;
    margin-bottom: 16px;
    border: 1px solid var(--line);
    border-radius: 20px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    background: var(--surface);
    color: var(--ink);
  }

  .search-input:focus {
    border-color: var(--violet);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .filter {
    font-family: var(--font-body);
    font-size: 0.85rem;
    padding: 8px 14px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .filter.active {
    background: var(--violet);
    color: #ffffff;
    border-color: var(--violet);
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding-bottom: 16px;
  }

  @media (max-width: 860px) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }

  .more-wrap {
    display: flex;
    justify-content: center;
    margin-block: 24px 40px;
  }

  .more-btn {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 28px;
    border-radius: 999px;
    border: 0;
    color: #fff;
    cursor: pointer;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .more-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .no-results {
    color: var(--ink-soft);
    padding-bottom: 40px;
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('.post-item');
  const searchInput = document.querySelector<HTMLInputElement>('#search-input');
  const noResults = document.querySelector<HTMLElement>('#no-results');

  const PAGE_SIZE = 6;
  const moreWrap = document.querySelector<HTMLElement>('#more-wrap');
  const moreBtn = document.querySelector<HTMLButtonElement>('#more-posts');

  let activeCategory = 'all';
  let shown = PAGE_SIZE;

  function applyFilters() {
    const query = (searchInput?.value ?? '').trim().toLowerCase();
    let visibleCount = 0;

    items.forEach((item) => {
      const matchesCategory = activeCategory === 'all' || item.dataset.category === activeCategory;
      const matchesQuery = !query || (item.dataset.search ?? '').includes(query);
      const matches = matchesCategory && matchesQuery;
      if (matches) visibleCount += 1;
      item.style.display = matches && visibleCount <= shown ? '' : 'none';
    });

    if (moreWrap) moreWrap.hidden = visibleCount <= shown;

    if (noResults) noResults.hidden = visibleCount > 0;
    filters.forEach((f) => f.classList.toggle('active', f.dataset.category === activeCategory));
  }

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category ?? 'all';
      shown = PAGE_SIZE;
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', () => {
    shown = PAGE_SIZE;
    applyFilters();
  });

  moreBtn?.addEventListener('click', () => {
    shown += PAGE_SIZE;
    applyFilters();
  });

  const params = new URLSearchParams(window.location.search);
  const initialCategory = params.get('category');
  const initialQuery = params.get('q');
  if (initialCategory) activeCategory = initialCategory;
  if (initialQuery && searchInput) searchInput.value = initialQuery;
  applyFilters();
</script>
