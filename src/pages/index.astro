---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import HomeLead from '../components/HomeLead.astro';
import LatestList from '../components/LatestList.astro';
import CategoryBlock from '../components/CategoryBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import TrendBar from '../components/TrendBar.astro';
import Pagination from '../components/Pagination.astro';
import StoriesStrip from '../components/StoriesStrip.astro';
import ThemeCloud from '../components/ThemeCloud.astro';
import { categories, categoryHref } from '../data/categories';
import { isPublished, sortByActivity } from '../utils/posts';

// Page 1: lead (3 posts) + "Últimas" (the next 9). Pages 2+ continue from there as a card grid,
// so /page/2/ starts exactly where the "Últimas" column ends.
const PER_PAGE = 9;
const page = Number(Astro.props.page ?? 1);
const all = sortByActivity(await getCollection('blog', isPublished));
const lead = all.slice(0, 3);
const gridAll = all.slice(3);
const totalPages = Math.max(1, Math.ceil(gridAll.length / PER_PAGE));
const posts = gridAll.slice((page - 1) * PER_PAGE, page * PER_PAGE);

// One block per category with at least 4 posts outside the lead, biggest categories first.
const blocks = categories
  .map((c) => ({
    name: c.name,
    href: categoryHref(c.name),
    total: all.filter((p) => p.data.category === c.name).length,
    posts: gridAll.filter((p) => p.data.category === c.name).slice(0, 4),
  }))
  .filter((b) => b.posts.length >= 4)
  .sort((a, b) => b.total - a.total);
---
<BaseLayout title={page > 1 ? `IA, Jogos, Tutoriais e Tecnologia - Página ${page}` : "IA, Jogos, Tutoriais e Tecnologia"} description="Guias, reviews e notícias sobre IA, jogos, tutoriais e curiosidades, em linguagem simples.">
  <h1 class="sr-only">TechOnPlay: tecnologia sem complicação</h1>

  {page === 1 ? (
    <>
      <TrendBar posts={all.slice(0, 6)} />

      <section class="container top">
        <div class="top-lead">
          <HomeLead posts={lead} />
        </div>
        <aside class="top-latest" aria-labelledby="latest-title" data-reveal="fade">
          <SectionHead title="Últimas" id="latest-title" />
          <LatestList posts={posts} />
          {totalPages > 1 && <a class="more-posts" href="/page/2/">Mais posts</a>}
        </aside>
      </section>

      <div data-reveal="up"><StoriesStrip /></div>

      <section class="container themes" aria-labelledby="themes-title" data-reveal="up">
        <SectionHead title="Temas em alta" id="themes-title" />
        <ThemeCloud variant="home" />
      </section>

      {blocks.length > 0 && (
        <div class="container blocks">
          {blocks.map((b) => <div data-reveal="up"><CategoryBlock {...b} /></div>)}
        </div>
      )}
    </>
  ) : (
    <section class="container recent">
      <SectionHead title={`Todos os posts, página ${page}`} />
      <div class="grid" data-reveal="group">
        {posts.map((post, i) => (
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            date={post.data.date}
            readingTime={post.data.readingTime}
            image={post.data.image}
            imageAlt={post.data.imageAlt}
            priority={i === 0}
          />
        ))}
      </div>
      <Pagination current={page} total={totalPages} />
    </section>
  )}
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 40px;
    padding-block: 36px 48px;
  }

  .more-posts {
    display: block;
    margin-top: 12px;
    padding: 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-align: center;
    transition: border-color var(--dur-normal) ease, color var(--dur-normal) ease;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink-strong);
    text-decoration: none;
  }

  .more-posts:hover {
    border-color: var(--violet);
    color: var(--link-text);
  }

  .themes {
    padding-block: 8px 40px;
  }

  .blocks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 40px;
    padding-block: 16px 64px;
  }

  .recent {
    padding-block: 40px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 960px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .blocks {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
