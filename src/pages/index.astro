---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { isPublished, sortByActivity } from '../utils/posts';

const PAGE_SIZE = 6;
const posts = sortByActivity(await getCollection('blog', isPublished));
---
<BaseLayout title="IA, Jogos, Tutoriais e Tecnologia" description="Guias, reviews e notícias sobre IA, jogos, tutoriais e curiosidades, em linguagem simples.">
  <section class="hero container">
    <h1 class="sr-only">Tecnologia sem complicação.</h1>
    <p class="eyebrow">techonplay.com.br<span class="eyebrow-cursor">_</span></p>
  </section>

  <section class="container recent">
    <div class="recent-header">
      <div>
        <h2>Artigos recentes</h2>
        <span class="underline"></span>
      </div>
      <a href="/blog">Ver todos →</a>
    </div>
    <div class="grid">
      {posts.map((post, i) => (
        <div class={i < PAGE_SIZE ? 'item' : 'item extra'}>
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
          priority={i === 0}
        />
        </div>
      ))}
    </div>
    {posts.length > PAGE_SIZE && (
      <div class="more-wrap">
        <button type="button" id="more-posts" class="more-btn" data-step={PAGE_SIZE}>Ver mais posts</button>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  const btn = document.querySelector<HTMLButtonElement>('#more-posts');
  btn?.addEventListener('click', () => {
    const step = Number(btn.dataset.step) || 6;
    const hidden = document.querySelectorAll<HTMLElement>('.item.extra:not(.show)');
    hidden.forEach((el, i) => {
      if (i < step) el.classList.add('show');
    });
    if (hidden.length <= step) btn.parentElement?.remove();
  });
</script>

<style>
  .hero {
    padding-block: 48px 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .eyebrow-cursor {
    display: inline-block;
    margin-left: 2px;
    color: var(--rose);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .recent {
    padding-block: 40px;
  }

  .recent-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
  }

  .underline {
    display: block;
    width: 48px;
    height: 4px;
    margin-top: 10px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
  }

  .recent-header a {
    text-decoration: none;
    color: var(--teal);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .item {
    display: contents;
  }

  .item.extra:not(.show) {
    display: none;
  }

  .more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .more-btn {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 28px;
    border-radius: 999px;
    border: 0;
    color: #fff;
    cursor: pointer;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .more-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

