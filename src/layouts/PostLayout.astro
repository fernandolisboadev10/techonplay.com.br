---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ThemeCloud from '../components/ThemeCloud.astro';
import PostNav from '../components/PostNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import type { MarkdownHeading } from 'astro';
import { categoryHref } from '../data/categories';

interface Props {
  title: string;
  seoTitle?: string;
  faq?: { question: string; answer: string }[];
  description: string;
  category: string;
  date: Date;
  updated?: Date;
  related?: string[];
  tags?: string[];
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  slug: string;
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
  headings?: MarkdownHeading[];
}
const { title, seoTitle, faq, description, category, date, updated, related, tags, readingTime, image, imageAlt, prev, next, headings = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// "Atualizado em" só aparece quando o artigo foi editado em um dia depois da publicação.
const formattedUpdated = updated?.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const showUpdated = !!formattedUpdated && formattedUpdated !== formattedDate && updated!.getTime() > date.getTime();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: image ? [new URL(image.src, Astro.site).toString()] : undefined,
  keywords: tags?.join(", "),
  articleSection: category,
  inLanguage: "pt-BR",
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Fernando Lisboa',
    url: new URL('/sobre-nos', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'TechOnPlay',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/logo.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};

const faqSchema = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : undefined;

// Same threshold as TableOfContents: the side guide only shows up for posts with 3+ sections.
const hasGuide = headings.filter((h) => h.depth === 2).length >= 3;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: category, item: new URL(categoryHref(category), Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---
<BaseLayout title={title} seoTitle={seoTitle} description={description} image={image?.src} type="article" published={date} modified={updated ?? date}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <ReadingProgress />
  <div class:list={['container post-shell', { 'no-guide': !hasGuide }]}>
    <article class="post">
      <header class="post-head">
        <nav class="crumbs" aria-label="Você está em">
          <a href="/">Início</a>
          <span aria-hidden="true">›</span>
          <a href={categoryHref(category)}>{category}</a>
        </nav>
        <h1>{title}</h1>
        <p class="meta">
          Por <a href="/sobre-nos">Fernando Lisboa</a> | <time datetime={date.toISOString()}>{formattedDate}</time>{showUpdated && <> | Atualizado em <time datetime={updated!.toISOString()}>{formattedUpdated}</time></>}{readingTime && `, ${readingTime} de leitura`}
        </p>
        <ShareButtons title={title} />

        {image && (
          <div class="hero-image">
            <Image src={image} alt={imageAlt ?? title} width={720} height={480} quality={70} priority />
          </div>
        )}
      </header>

      <div class="post-body">
        <div class="prose">
          <slot />
        </div>

        <ShareButtons title={title} variant="end" />

        <PostNav prev={prev} next={next} />

        <div data-reveal="up"><AuthorBio /></div>
        <ThemeCloud variant="post" slug={Astro.props.slug} tags={tags} />
        <div data-reveal="up"><RelatedPosts slug={Astro.props.slug} category={category} tags={tags} related={related} /></div>
      </div>
    </article>

    {hasGuide && (
      <aside class="post-aside">
        <TableOfContents headings={headings} />
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  function legacyCopy(text: string): boolean {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    document.body.removeChild(textarea);
    return ok;
  }

  // The markdown tables only contain the text "📋 Copiar"; turn those cells into working copy buttons.
  function setupCopyButtons() {
    let uid = 0;
    const makeButton = (label: string, targetId: string) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.dataset.copyTarget = targetId;
      btn.textContent = label;
      return btn;
    };

    document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
      const headers = Array.from(table.querySelectorAll('thead th'));
      let cmdCol = headers.findIndex((th) => /comando|c[oó]digo/i.test(th.textContent ?? ''));
      const rows = Array.from(table.querySelectorAll<HTMLTableRowElement>('tbody tr'));
      const commands: string[] = [];

      rows.forEach((row) => {
        const cells = Array.from(row.children) as HTMLElement[];
        const actionCell = cells.find((c) => c.tagName === 'TD' && (c.textContent ?? '').trim() === '📋 Copiar');
        if (!actionCell) return;
        if (cmdCol < 0 || !cells[cmdCol]) cmdCol = cells.findIndex((c) => c.querySelector('code'));
        const cmdCell = cells[cmdCol];
        if (!cmdCell) return;
        const id = 'copy-cmd-' + uid++;
        cmdCell.id = id;
        commands.push((cmdCell.textContent ?? '').trim());
        actionCell.textContent = '';
        actionCell.appendChild(makeButton('📋 Copiar', id));
      });

      // "📋 Copiar todos os N" paragraph right before the table
      const prev = table.previousElementSibling;
      if (prev && prev.tagName === 'P' && /^📋\s*Copiar todos/i.test((prev.textContent ?? '').trim()) && commands.length) {
        const all = document.createElement('pre');
        all.id = 'copy-all-' + uid++;
        all.hidden = true;
        all.textContent = commands.join('\n');
        const label = (prev.textContent ?? '').trim();
        prev.textContent = '';
        prev.appendChild(makeButton(label, all.id));
        prev.appendChild(all);
      }
    });
  }

  setupCopyButtons();

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn');
    if (!button) return;

    const targetId = button.dataset.copyTarget;
    const target = targetId && document.getElementById(targetId);
    if (!target) return;

    const text = target.textContent?.trim() ?? '';
    const original = button.textContent;

    const showFeedback = (label: string, isError: boolean) => {
      button.textContent = label;
      button.classList.toggle('copied', !isError);
      button.classList.toggle('copy-error', isError);
      setTimeout(() => {
        button.textContent = original;
        button.classList.remove('copied', 'copy-error');
      }, 1500);
    };

    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(text).then(
        () => showFeedback('Copiado!', false),
        () => {
          const ok = legacyCopy(text);
          showFeedback(ok ? 'Copiado!' : 'Use Ctrl+C', !ok);
        },
      );
    } else {
      const ok = legacyCopy(text);
      showFeedback(ok ? 'Copiado!' : 'Use Ctrl+C', !ok);
    }
  });
</script>

<style>
  /* Article and guide side by side on desktop; the guide drops between cover and text on smaller screens. */
  .post-shell {
    padding-block: 40px 56px;
    display: grid;
    grid-template-columns: minmax(0, 760px) 280px;
    grid-template-areas: 'post aside';
    justify-content: space-between;
    column-gap: 48px;
  }

  .post-head,
  .post-body,
  .post-aside {
    min-width: 0;
  }

  .post {
    grid-area: post;
    min-width: 0;
  }

  .post-aside {
    grid-area: aside;
    padding-top: 36px;
  }

  .post-shell.no-guide {
    max-width: 768px;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'post';
  }

  @media (max-width: 1099px) {
    /* Header, guide and body share one grid so the guide sits between cover and text. */
    .post-shell,
    .post-shell.no-guide {
      max-width: 768px;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'head' 'aside' 'body';
    }

    .post {
      display: contents;
    }

    .post-head {
      grid-area: head;
    }

    .post-aside {
      grid-area: aside;
      padding-top: 0;
      margin-bottom: 32px;
    }

    .post-body {
      grid-area: body;
      min-width: 0;
    }
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .crumbs a:last-child {
    color: var(--ink-strong);
  }

  .crumbs a:hover {
    color: var(--link-text);
  }

  h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.02;
    text-wrap: balance;
    margin-bottom: 18px;
  }

  .meta {
    margin: 0 0 20px;
    padding-block: 16px;
    border-block: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .meta a {
    color: var(--ink-strong);
    text-decoration: none;
    font-weight: 600;
  }

  .meta a:hover {
    color: var(--link-text);
  }

  .hero-image {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 40px;
    background: var(--surface-2);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.download-box) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 28px 0;
    padding: 18px 20px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--surface-2);
  }

  :global(.download-box-icon) {
    font-size: 2rem;
    line-height: 1;
  }

  :global(.download-box-text) {
    flex: 1;
    min-width: 0;
  }

  :global(.download-box-text strong) {
    display: block;
    color: var(--ink-strong);
    font-size: 1.05rem;
    margin-bottom: 2px;
  }

  :global(.download-box-text span) {
    display: block;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  :global(.download-box a.download-box-btn) {
    flex: none;
    padding: 11px 20px;
    border-radius: 4px;
    background: var(--violet);
    color: #fff;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    white-space: nowrap;
  }

  :global(.download-box a.download-box-btn:hover) {
    filter: brightness(1.1);
  }

  @media (max-width: 640px) {
    :global(.download-box) {
      flex-direction: column;
      align-items: stretch;
      text-align: left;
    }

    :global(.download-box a.download-box-btn) {
      text-align: center;
    }
  }

  :global(.prompt-card) {
    margin: 24px 0;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.prompt-card-bar) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--ink-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.prompt-card-bar .dot) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  :global(.prompt-card-bar .dot-red) {
    background: #ff5f56;
  }

  :global(.prompt-card-bar .dot-yellow) {
    background: #ffbd2e;
  }

  :global(.prompt-card-bar .dot-green) {
    background: #27c93f;
  }

  :global(.prompt-card-label) {
    margin-left: 4px;
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.45);
  }

  :global(.copy-btn) {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
    color: #ece7fb;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  :global(.copy-btn:hover) {
    border-color: var(--teal-soft);
    color: var(--teal-soft);
  }

  :global(.copy-btn.copied) {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
  }

  :global(.copy-btn.copy-error) {
    background: #dc2626;
    border-color: #dc2626;
    color: #ffffff;
  }

  :global(.prompt-card pre) {
    margin: 0;
    border-radius: 0;
  }
</style>
