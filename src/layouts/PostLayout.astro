---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import PostNav from '../components/PostNav.astro';
import { categoryHref } from '../data/categories';

interface Props {
  title: string;
  description: string;
  category: string;
  date: Date;
  updated?: Date;
  related?: string[];
  tags?: string[];
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  slug: string;
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}
const { title, description, category, date, updated, related, tags, readingTime, image, imageAlt, prev, next } = Astro.props;

const formattedDate = date.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: image ? [new URL(image.src, Astro.site).toString()] : undefined,
  keywords: tags?.join(", "),
  articleSection: category,
  inLanguage: "pt-BR",
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Fernando Lisboa',
    url: new URL('/sobre-nos', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'TechOnPlay',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/logo.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};
---
<BaseLayout title={title} description={description} image={image?.src} type="article" published={date} modified={updated ?? date}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="container post">
    <p class="category"><a href={categoryHref(category)}>{category}</a></p>
    <h1>{title}</h1>
    <p class="meta">
      Por <a href="/sobre-nos">Fernando Lisboa</a> | {formattedDate}{readingTime && ` · ${readingTime}`}
    </p>
    <ShareButtons title={title} />

    {image && (
      <div class="hero-image">
        <Image src={image} alt={imageAlt ?? title} width={720} height={480} quality={70} priority />
      </div>
    )}

    <div class="prose">
      <slot />
    </div>

    <ShareButtons title={title} variant="end" />

    <PostNav prev={prev} next={next} />

    <AuthorBio />
    <RelatedPosts slug={Astro.props.slug} category={category} tags={tags} related={related} />
  </article>
</BaseLayout>

<script>
  function legacyCopy(text: string): boolean {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    document.body.removeChild(textarea);
    return ok;
  }

  // The markdown tables only contain the text "📋 Copiar"; turn those cells into working copy buttons.
  function setupCopyButtons() {
    let uid = 0;
    const makeButton = (label: string, targetId: string) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.dataset.copyTarget = targetId;
      btn.textContent = label;
      return btn;
    };

    document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
      const headers = Array.from(table.querySelectorAll('thead th'));
      let cmdCol = headers.findIndex((th) => /comando|c[oó]digo/i.test(th.textContent ?? ''));
      const rows = Array.from(table.querySelectorAll<HTMLTableRowElement>('tbody tr'));
      const commands: string[] = [];

      rows.forEach((row) => {
        const cells = Array.from(row.children) as HTMLElement[];
        const actionCell = cells.find((c) => c.tagName === 'TD' && (c.textContent ?? '').trim() === '📋 Copiar');
        if (!actionCell) return;
        if (cmdCol < 0 || !cells[cmdCol]) cmdCol = cells.findIndex((c) => c.querySelector('code'));
        const cmdCell = cells[cmdCol];
        if (!cmdCell) return;
        const id = 'copy-cmd-' + uid++;
        cmdCell.id = id;
        commands.push((cmdCell.textContent ?? '').trim());
        actionCell.textContent = '';
        actionCell.appendChild(makeButton('📋 Copiar', id));
      });

      // "📋 Copiar todos os N" paragraph right before the table
      const prev = table.previousElementSibling;
      if (prev && prev.tagName === 'P' && /^📋\s*Copiar todos/i.test((prev.textContent ?? '').trim()) && commands.length) {
        const all = document.createElement('pre');
        all.id = 'copy-all-' + uid++;
        all.hidden = true;
        all.textContent = commands.join('\n');
        const label = (prev.textContent ?? '').trim();
        prev.textContent = '';
        prev.appendChild(makeButton(label, all.id));
        prev.appendChild(all);
      }
    });
  }

  setupCopyButtons();

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn');
    if (!button) return;

    const targetId = button.dataset.copyTarget;
    const target = targetId && document.getElementById(targetId);
    if (!target) return;

    const text = target.textContent?.trim() ?? '';
    const original = button.textContent;

    const showFeedback = (label: string, isError: boolean) => {
      button.textContent = label;
      button.classList.toggle('copied', !isError);
      button.classList.toggle('copy-error', isError);
      setTimeout(() => {
        button.textContent = original;
        button.classList.remove('copied', 'copy-error');
      }, 1500);
    };

    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(text).then(
        () => showFeedback('Copiado!', false),
        () => {
          const ok = legacyCopy(text);
          showFeedback(ok ? 'Copiado!' : 'Use Ctrl+C', !ok);
        },
      );
    } else {
      const ok = legacyCopy(text);
      showFeedback(ok ? 'Copiado!' : 'Use Ctrl+C', !ok);
    }
  });
</script>

<style>
  .post {
    max-width: 720px;
    padding-block: 56px;
  }

  .category a {
    color: inherit;
    text-decoration: none;
  }

  .category a:hover {
    text-decoration: underline;
  }

  .category {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--violet);
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 12px;
  }

  .meta {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin: 0 0 20px;
  }

  .meta a {
    color: var(--violet);
    text-decoration: none;
    font-weight: 600;
  }

  .meta a:hover {
    text-decoration: underline;
  }

  .hero-image {
    aspect-ratio: 3 / 2;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.prompt-card) {
    margin: 24px 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 16px 32px -20px rgba(91, 33, 182, 0.35);
  }

  :global(.prompt-card-bar) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--ink-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.prompt-card-bar .dot) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  :global(.prompt-card-bar .dot-red) {
    background: #ff5f56;
  }

  :global(.prompt-card-bar .dot-yellow) {
    background: #ffbd2e;
  }

  :global(.prompt-card-bar .dot-green) {
    background: #27c93f;
  }

  :global(.prompt-card-label) {
    margin-left: 4px;
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.45);
  }

  :global(.copy-btn) {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.78rem;
    padding: 5px 12px;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
    color: #ece7fb;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  :global(.copy-btn:hover) {
    border-color: var(--teal-soft);
    color: var(--teal-soft);
  }

  :global(.copy-btn.copied) {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
  }

  :global(.copy-btn.copy-error) {
    background: var(--rose);
    border-color: var(--rose);
    color: #ffffff;
  }

  :global(.prompt-card pre) {
    margin: 0;
    border-radius: 0;
  }
</style>
